# 服务器监听
PORT=8080
HOST=0.0.0.0

# 你自己的音乐文件目录（放 mp3/flac/m4a 等）
MUSIC_DIR=D:\work\music-app\server\music

# SQLite 数据库位置
DB_PATH=D:\work\music-app\server\data\library.db

# 合法在线音源 Jamendo（可选）
# 免费注册: https://developer.jamendo.com/
# 不填则只启用本地曲库
JAMENDO_CLIENT_ID=

# 访问口令（App 设置里填写相同值；留空则不校验，公网部署务必设置）
ACCESS_KEY=

# ffmpeg 可执行文件路径（留空则使用系统 PATH 中的 ffmpeg）
FFMPEG_PATH=

# 曲库自动刷新间隔（秒，0=关闭）
AUTO_SCAN_INTERVAL=15
